# Python/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local/editor/runtime state
.claude/settings.local.json
.time_logger_state.json
.tmp/
.cache/
mnt/
envs/

# Raw data and large downloaded assets
datasets/raw/
data/raw/
*.csv.gz
*.extxyz.zip
uma_ckpts/
mattertune/dpa/
mattertune/dpa4/
mattertune/**/*.pt
mattertune/**/*.pth
mattertune/**/*.model
mattertune/**/.cache/

# Generated datasets that can be rebuilt
datasets/prepared/*/dp_*/
data/**/dp_*/

# Experiment artifacts
experiments/checkpoints/
experiments/predictions/
experiments/verdicts/
experiments/time_logs/
runs/
results/
results/time_logs/
results/**/*.npz
results/**/*.xyz

# Datasets, including small prepared samples
data/**/*.extxyz
data/**/*.xyz
data/**/*.csv
data/**/*.npz
datasets/**/*.extxyz
datasets/**/*.xyz
datasets/**/*.csv
datasets/**/*.npz


# Vendored Matbench Discovery source data and tiny upstream fixtures
!scoring/adapters/matbench_discovery/upstream/data/**/*.csv.gz
!scoring/adapters/matbench_discovery/upstream/tests/files/*.csv.gz

# Keep lightweight dataset metadata if useful
data/**/manifest.json
datasets/**/manifest.json
data/prep_scripts/
data/prep_scripts/**

# One-off data preparation and experiment analysis scripts
/data_prep.py
/prepare_*.py
/mp_vs_off_force_delta.py
/verdict.py
/tools/eval_ft.py
/tools/pearson_ft.py
/tools/run_mace_ft.sh

# Runtime logs and playground run outputs
logs/
playground/runs/
playground/cache/
playground/scripts/__pycache__/
# Downloaded MATPES parquet/cache files
data/**/*.parquet
data/**/_cache/

# Local docs drafts; only the public MatterTune Bash API spec is versioned
/docs/*
!/docs/mattertune_bash_api.md
scoring/adapters/matbench_discovery/upstream/data/**/*.jsonl.gz

# Public MACE-MOF-0 artifacts; keep only provenance manifest in git
data/mace_mof_0/**
!data/mace_mof_0/
!data/mace_mof_0/manifest.json
