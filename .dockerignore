# Conda environments (huge, not needed in Docker images)
envs/

# Python cache
__pycache__/
*.pyc
.cache/

# Build artifacts
.mypy_cache/
*.egg-info/

# Data files (mounted at runtime, not baked into images)
data/
datasets/*
!data/prep_scripts/
!data/prep_scripts/*.py

# Checkpoints (mounted at runtime)
mattertune/dpa/
mattertune/dpa4/
uma_ckpts/

# Run outputs
results/
runs/

# Temporary files
.tmp/
tmp/

# Git
.git/

# IDE / editor
.vscode/
.idea/

# Misc large files
*.csv.gz
*.zip
*.tar
*.tar.bz2

# Docker
Dockerfile*
.dockerignore

# Conda
*.conda
miniconda3/
# mat-agent generated runtime state
playground/runs/
playground/cache/
playground/scripts/__pycache__/
logs/

# Legacy wrappers are kept for migration reference, not baked into unified image
legacy_model_apis/

# Nested repositories and local runtime state
mattertune/.git/
mattertune/log.txt
.venvs/
# Large benchmark/source caches not needed by the Docker image
benchmark/
.cache/
