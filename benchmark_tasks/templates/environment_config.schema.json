{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Environment Config",
  "type": "object",
  "required": ["env_id", "task_type", "foundation_models", "episode", "splits", "actions", "feedback_channels", "score"],
  "properties": {
    "env_id": {"type": "string"},
    "task_type": {"type": "string"},
    "source_registry_env_id": {"type": "string"},
    "foundation_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path_or_source", "status"],
        "properties": {
          "name": {"type": "string"},
          "path_or_source": {},
          "status": {"type": "string"}
        }
      }
    },
    "episode": {
      "type": "object",
      "required": ["oracle_budget_levels", "max_rounds", "max_train_minutes_per_round"],
      "properties": {
        "initial_visible_frames": {"type": "array"},
        "oracle_budget_levels": {"type": "array", "items": {"type": "integer"}},
        "max_rounds": {"type": "integer"},
        "max_train_minutes_per_round": {"type": "integer"},
        "reduced_mode": {"type": "boolean"}
      }
    },
    "splits": {"type": "object"},
    "actions": {"type": "array", "items": {"type": "string"}},
    "feedback_channels": {"type": "array", "items": {"type": "string"}},
    "score": {"type": "object"}
  }
}
