FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Step 1: Install ca-certificates FIRST from default HTTP repos, then switch to HTTPS mirrors
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    sed -i 's|http://archive.ubuntu.com|https://mirrors.aliyun.com|g; s|http://security.ubuntu.com|https://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        git curl build-essential gnupg wget \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# CUDA 12.1 from NVIDIA China CDN
RUN wget -q https://developer.download.nvidia.cn/compute/cuda/repos/ubuntu2204/x86_64/cuda-keyring_1.1-1_all.deb -O /tmp/cuda.deb && \
    dpkg -i /tmp/cuda.deb && rm /tmp/cuda.deb && \
    sed -i 's|developer.download.nvidia.com|developer.download.nvidia.cn|g' /etc/apt/sources.list.d/cuda-*.list 2>/dev/null || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends cuda-libraries-12-1 libcudnn8 && \
    rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV CUDA_VERSION=12.1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Python deps via tsinghua mirror
RUN pip3 install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        "ase>=3.22" "numpy>=1.23" "scipy"

# Shared data, benchmark, and playground dependencies.
# These belong in base because data preparation and judging are model-agnostic.
COPY requirements-data.txt /tmp/requirements-data.txt
RUN pip3 install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        -r /tmp/requirements-data.txt && \
    rm /tmp/requirements-data.txt

# matbench pins an old scikit-learn release that has no reliable Python 3.11
# wheel. Install the package itself while keeping the modern dependency stack
# from requirements-data.txt.
RUN pip3 install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --no-deps "matbench==0.6"

RUN mkdir -p /work /opt/mat-agent-tools /opt/mat-agent-datasets

COPY tools/ase_conventions.py /opt/mat-agent-tools/
COPY tools/verdict.py /opt/mat-agent-tools/
COPY datasets/prep_scripts/ /opt/mat-agent-datasets/prep_scripts/

ENV PYTHONPATH=/opt/mat-agent-tools:/opt/mat-agent-datasets
ENV HF_ENDPOINT=https://hf-mirror.com

WORKDIR /work
ENTRYPOINT []
CMD ["/bin/bash"]
